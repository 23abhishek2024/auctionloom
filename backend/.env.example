# Database Configuration (Local or Cloud)
# For Cloud DBs (AWS RDS, Supabase, Neon, Render), use DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/primebid?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=primebid
DB_USER=postgres
DB_PASSWORD=secret
DB_POOL_MAX=10
DISABLE_DB_SSL=false
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
