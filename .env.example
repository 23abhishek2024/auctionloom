# Prime Bid - Environment Variables Configuration

# Database Configuration (Docker / Local / Cloud)
# For managed cloud DBs (AWS RDS, Supabase, Neon, Render), set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/primebid?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=primebid
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DISABLE_DB_SSL=false

# Backend API Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=supersecret_jwt_key_primebid_change_in_production
FRONTEND_URL=http://localhost:3000

# Google Gemini AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Vite Build Arguments (Optional)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Transactional Email Delivery Strategy (Dual Mode)
# Modes: 'ethereal' (default test web previews), 'smtp' (real delivery), 'smart' (auto-routes test accounts)
EMAIL_DELIVERY_MODE=smart
EMAIL_FROM="AuctionLoom Settlements" <settlements@auctionloom.com>
# Optional Real SMTP Config (e.g. Gmail App Password, Resend, SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Razorpay Payment Gateway (Optional Test / Live API Keys)
# If left unset or set to placeholder, the platform runs in high-fidelity sandbox simulation mode
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# ============================================================
# 🛠️ DATABASE RESET & SEED COMMAND
# To wipe and re-seed clean test data anytime, run:
#   cd backend && npm run seed
#
# Seeded Test Accounts (Password for all: test@123):
#   - Test1: test1@gmail.com (or test1@gamil.com)
#   - Test2: test2@gmail.com (or test2@gamil.com)
#   - Test3: test3@gmail.com (or test3@gamil.com)
#   - Test4: test4@gmail.com (or test4@gamil.com)
#   - Test5: test5@gmail.com (or test5@gamil.com)
#   - Admin: admin@gmail.com (or admin@gamil.com)
