# Prime Bid - Environment Variables Configuration

# Database Configuration (Docker / Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=primebid
DB_USER=postgres
DB_PASSWORD=postgres

# Backend API Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=supersecret_jwt_key_primebid_change_in_production
FRONTEND_URL=http://localhost:3000

# Google Gemini AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Vite Build Arguments (Optional)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
